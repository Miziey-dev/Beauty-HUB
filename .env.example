# Copy to .env and fill in real values. Never commit the real .env.

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key

# Paystack (Settings -> API Keys & Webhooks) — test keys for dev
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Google Maps SDK + Places API (Google Cloud Console)
GOOGLE_MAPS_API_KEY=replace-with-maps-key

# Firebase Cloud Messaging (Firebase Console -> Project settings -> Cloud Messaging)
FIREBASE_PROJECT_ID=replace-with-firebase-project-id

# Google OAuth (for Supabase "Sign in with Google")
GOOGLE_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
